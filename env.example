# Auto-Sell.ai — environment variables
# Copy to `.env.local` and fill in. Never commit the filled-in file.
# See CONTRIBUTING.md §3 for what each one unlocks.

# ── Required: the dev server will not start without these ────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Admin (/admin) ───────────────────────────────────────────────────────────
# Without the service role key, admin API routes return 500.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ADMIN_PASSWORD=your_admin_password

# ── Lead pipeline ────────────────────────────────────────────────────────────
# Rego -> vehicle lookup used by the quote form.
AUTOGRAB_API_KEY=your_autograb_api_key

# Pipedrive CRM sync — OfferForm fires /api/pipedrive-lead on submit
# (non-blocking; without the token the route 502s and the lead still saves).
PIPEDRIVE_API_TOKEN=your_pipedrive_api_token

# Lead notification email (AWS SES).
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SES_REGION=ap-southeast-2
SES_FROM_EMAIL=noreply@auto-sell.ai
SES_TO_EMAIL=leads@auto-sell.ai

# ── Analytics & embeds (optional in local dev) ───────────────────────────────
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
NEXT_PUBLIC_GOOGLE_MAPS_PLACE_ID=your_google_place_id

# ── Not in use ───────────────────────────────────────────────────────────────
# Close CRM, Twilio (SMS/WhatsApp) and the chatbot are present in the codebase
# but disabled. Do not configure or build on them without checking first.
# CLOSE_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_NUMBER=
# TWILIO_WHATSAPP_NUMBER=
